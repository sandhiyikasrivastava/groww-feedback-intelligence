# Streamlit secrets for Streamlit Community Cloud.
#
# Copy this file to `.streamlit/secrets.toml` locally (it is git-ignored) or
# paste the values into the "Secrets" section of the deployed app.
# Never commit real keys.

# --- LLM provider (optional) ----------------------------------------------
# With no key the app runs in "offline deterministic mode": themes and
# reports are composed from the validated data with a documented rule-based
# method instead of by a language model.
LLM_PROVIDER = "groq"          # "groq" | "openai" | "none"
GROQ_API_KEY = ""
GROQ_MODEL = "llama-3.3-70b-versatile"
# OPENAI_API_KEY = ""
# OPENAI_MODEL = "gpt-4o-mini"

# --- Notion (documentation service, optional) -----------------------------
# Without these the documentation append runs as an explicitly labelled
# simulation that writes to data/simulated/documentation_entries.jsonl.
NOTION_MCP_URL = "https://mcp.notion.com/mcp"
NOTION_API_KEY = ""
NOTION_PARENT_PAGE_ID = ""

# --- Gmail (email drafts, optional) ---------------------------------------
# Without these the email draft runs as an explicitly labelled simulation
# that writes to data/simulated/email_drafts.jsonl.  The application never
# calls a send tool: only "create_draft" is used.
GMAIL_MCP_COMMAND = "npx"
GMAIL_MCP_ARGS = "-y @modelcontextprotocol/server-gmail"
GMAIL_OAUTH_CREDENTIALS = ""
GMAIL_EMAIL_ADDRESS = ""
